#!/usr/bin/python3
# omapager-secret - the API key, kept in the desktop's secret service.
#
#   get          print the stored key, or nothing and exit 1
#   set          read the key from stdin and store it
#   clear        delete it
#   status       print {available, stored} as JSON
#
# The key is never written to a file, never passed in argv, and never included
# in an error message. `secret-tool` is the interface: it is libsecret's own
# CLI, it is present wherever a desktop keyring is, and talking to it keeps the
# key out of this process's memory for longer than one call.
#
# On a machine with no secret service this exits 1 and says so. There is no
# plaintext fallback: a key in shell.json is a key in every backup, every dotfile
# repository and every screenshot of the settings page.
import json
import os
import subprocess
import sys

SECRET_TOOL = "/usr/bin/secret-tool"
ATTRIBUTES = ("--label=Omapager LLM API key", "service", "omapager", "key", "llm")
MAX_KEY_BYTES = 4096


def _run(args, stdin=None, timeout=10):
    return subprocess.run([SECRET_TOOL, *args], input=stdin, capture_output=True,
                          timeout=timeout, env={"HOME": os.environ.get("HOME", ""),
                                                "PATH": "/usr/bin",
                                                "DBUS_SESSION_BUS_ADDRESS":
                                                    os.environ.get("DBUS_SESSION_BUS_ADDRESS", ""),
                                                "XDG_RUNTIME_DIR":
                                                    os.environ.get("XDG_RUNTIME_DIR", "")})


def available():
    return os.access(SECRET_TOOL, os.X_OK)


def get():
    if not available():
        return None
    try:
        result = _run(["lookup", "service", "omapager", "key", "llm"])
    except (OSError, subprocess.SubprocessError):
        return None
    if result.returncode != 0:
        return None
    value = result.stdout.decode("utf-8", "strict").strip()
    return value if value and len(value) <= MAX_KEY_BYTES else None


def put(value):
    if not available():
        raise RuntimeError("no secret service")
    value = value.strip()
    if not value or len(value) > MAX_KEY_BYTES:
        raise ValueError("invalid key")
    if any(ord(character) < 32 for character in value):
        raise ValueError("invalid key")
    # --label first, then the attribute pairs; the key itself arrives on stdin
    # so it never appears in the process list.
    result = _run(["store", *ATTRIBUTES], stdin=value.encode())
    if result.returncode != 0:
        raise RuntimeError("secret service refused the key")


def clear():
    if not available():
        return
    try:
        _run(["clear", "service", "omapager", "key", "llm"])
    except (OSError, subprocess.SubprocessError):
        pass


def status():
    return {"available": available(), "stored": get() is not None}


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    verb = argv[0] if argv else "status"
    try:
        if verb == "get":
            value = get()
            if value is None:
                return 1
            sys.stdout.write(value)
            return 0
        if verb == "set":
            data = sys.stdin.buffer.read(MAX_KEY_BYTES + 1)
            if len(data) > MAX_KEY_BYTES:
                raise ValueError("invalid key")
            put(data.decode("utf-8", "strict"))
            return 0
        if verb == "clear":
            clear()
            return 0
        if verb == "status":
            sys.stdout.write(json.dumps(status()))
            return 0
        return 2
    except (OSError, UnicodeError, ValueError, RuntimeError, subprocess.SubprocessError):
        # No detail: the value being handled is the one thing that must not
        # reach a log line, and every failure here is "not available".
        sys.stderr.write("omapager-secret: unavailable or rejected\n")
        return 1


if __name__ == "__main__":
    sys.exit(main())
